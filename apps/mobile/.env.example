# Copier en .env.local (jamais commité) pour choisir le serveur de l'app en développement.

# mock : serveur simulé dans l'app (par défaut).
# http : vrai backend (apps/api) uniquement.
# hybrid (développement) : vrai backend pour les routes déjà codées, simulation pour le reste.
EXPO_PUBLIC_API_MODE=mock

# En mode http, sans URL : l'app joint l'API sur la même machine que Metro
# (adresse IP détectée automatiquement), sur ce port.
# EXPO_PUBLIC_API_PORT=3000

# Ou une adresse précise (serveur de staging, autre machine…) :
# EXPO_PUBLIC_API_URL=http://192.168.1.48:3000
