# Copier en .env pour le développement local (ce fichier .env n'est jamais commité).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Docker Compose local (ports décalés : voir docker-compose.yml)
POSTGRES_PORT=5434
REDIS_PORT=6380
DATABASE_URL=postgres://lokky:lokky@localhost:5434/lokky
TEST_DATABASE_URL=postgres://lokky:lokky@localhost:5434/lokky_test
REDIS_URL=redis://localhost:6380

# Domaines (changent au passage à lokky.app : spec backend §18)
PUBLIC_WEB_ORIGIN=https://lokky.akylian.com

# Jetons d'accès : clé privée Ed25519, à générer avec « npm run keys:jwt » (jamais commitée).
JWT_PRIVATE_KEY=

# Emails : sans clé Resend, le code de connexion s'affiche dans le terminal du serveur.
RESEND_API_KEY=
EMAIL_FROM=Lokky <connexion@akylian.com>

# Connexion Apple et Google (identifiants publics de l'ancien projet, déjà par défaut).
# APPLE_BUNDLE_IDS=com.nach17.Lokky
# GOOGLE_CLIENT_IDS=…web…,…ios…

# Avatars sur Cloudflare R2 (facultatif en local : l'envoi de photo répond alors 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
AVATAR_PUBLIC_BASE_URL=
