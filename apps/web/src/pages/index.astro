  .button-light {
    color: var(--ink);
    background: white;
  }

  .community-image {
    position: relative;
    overflow: hidden;
    height: 330px;
    border-radius: 28px 28px 90px 28px;
    background: #e68c4f;
    transform: rotate(1.2deg);
  }

  .community-image img {
    transition: transform 500ms ease;
  }

  .community-sticker {
    position: absolute;
    right: -9px;
    bottom: 20px;
    display: grid;
    width: 100px;
    height: 100px;
    place-content: center;
    border-radius: 50%;
    color: var(--ink);
    background: #ffc857;
    font: 600 15px/1.2 'Fredoka', sans-serif;
    text-align: center;
    transform: rotate(8deg);
  }

  .app-cta {
    padding-top: 115px;
    padding-bottom: 78px;
    text-align: center;
  }

  .app-cta-mark {
    width: 58px;
    height: 58px;
    margin: 0 auto 22px;
    border-radius: 20px;
    box-shadow: 0 10px 25px #ff6b3d38;
