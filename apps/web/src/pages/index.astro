    grid-template-columns: 0.85fr 1fr;
    align-items: center;
    gap: 8%;
  }

  .eyebrow-light {
    color: #ffb194;
  }

  .community-copy h2 {
    margin-bottom: 18px;
  }

  .community-copy > p:not(.eyebrow) {
    max-width: 400px;
    margin-bottom: 25px;
    color: #d5d6d4;
    font-size: 14px;
    line-height: 1.8;
