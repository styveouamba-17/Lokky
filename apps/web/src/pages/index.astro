  .hero-image-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.28;
    border-radius: 30px;
    background: #141a20;
    box-shadow: 0 30px 70px #4b2b1929;
    animation: hero-image-reveal 1900ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .hero-image-frame img,
  .feature-image img,
  .community-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image-frame img {
    animation: hero-image-focus 2300ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .hero-spark {
    position: absolute;
    z-index: 1;
    display: block;
    width: 28px;
    height: 28px;
    pointer-events: none;
    color: #ffc857;
    fill: currentColor;
    animation: spark-appear 700ms 650ms ease-out both;
  }

  .hero-spark-one {
    top: -7px;
    right: -7px;
  }

  .hero-spark-two {
    bottom: 0;
    left: -8px;
    width: 19px;
    height: 19px;
    color: var(--orange);
    animation-delay: 850ms;
  }

  @keyframes hero-image-reveal {
    from {
      opacity: 0;
      clip-path: inset(18% 20% 18% 20% round 48px);
      transform: translateY(30px) rotate(2deg) scale(0.94);
    }
    to {
      opacity: 1;
      clip-path: inset(0 round 30px);
      transform: translateY(0) rotate(0) scale(1);
    }
  }

  @keyframes hero-image-focus {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes spark-appear {
    from {
      opacity: 0;
      transform: scale(0.4) rotate(-35deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  :global(html.reveal-ready) [data-reveal] {
    opacity: 0;
    transition:
      opacity 720ms cubic-bezier(0.2, 0.65, 0.25, 1),
      transform 820ms cubic-bezier(0.2, 0.65, 0.25, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  :global(html.reveal-ready) [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    will-change: auto;
  }

  :global(html.reveal-ready) [data-reveal='up'] {
    transform: translate3d(0, 26px, 0) scale(0.99);
  }

  :global(html.reveal-ready) [data-reveal='left'] {
    transform: translate3d(-30px, 0, 0) scale(0.99);
  }

  :global(html.reveal-ready) [data-reveal='right'] {
    transform: translate3d(30px, 0, 0) scale(0.99);
  }

  [data-reveal-delay='80'] { --reveal-delay: 80ms; }
  [data-reveal-delay='120'] { --reveal-delay: 120ms; }
  [data-reveal-delay='140'] { --reveal-delay: 140ms; }
  [data-reveal-delay='160'] { --reveal-delay: 160ms; }
  [data-reveal-delay='180'] { --reveal-delay: 180ms; }
  [data-reveal-delay='200'] { --reveal-delay: 200ms; }
  [data-reveal-delay='240'] { --reveal-delay: 240ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter,
    .hero-image-frame,
    .hero-image-frame img,
    .hero-spark {
      animation: none;
    }

    :global(html.reveal-ready) [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

