  .app-cta .eyebrow {
    justify-content: center;
  }

  .app-cta h2 {
    font-size: clamp(44px, 5vw, 64px);
  }

  .app-cta > p:not(.eyebrow) {
    max-width: 480px;
    margin: 18px auto 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .app-cta-phone {
    display: block;
    width: min(100%, 760px);
    height: auto;
    margin: 48px auto 0;
    border-radius: 26px;
    box-shadow: 0 28px 70px #18202b24;
  }

  .footer {
    display: flex;
    max-width: 1200px;
    margin: auto;
    padding: 25px max(5vw, 24px);
    border-top: 1px solid #eee4d9;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .footer-brand {
    font-size: 20px;
  }

  .footer-brand .brand-mark,
  .footer-brand .brand-mark img {
    width: 30px;
    height: 30px;
  }

  .footer p,
  .copyright {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .footer-heart {
    width: 13px;
    height: 13px;
    margin: 0 3px;
    vertical-align: -2px;
    fill: var(--orange);
    stroke: var(--orange);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  @media (min-width: 1441px) {
    .feature-sand {
      border-radius: 28px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 570px;
      padding-top: 45px;
      grid-template-columns: 1fr 0.9fr;
      gap: 4%;
    }

    .intro {
      grid-template-columns: 1fr 0.8fr;
      gap: 5%;
    }

    .feature {
      gap: 6%;
    }

    .community-content {
      gap: 5%;
    }

    .app-tour-grid {
      gap: 14px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .app-tour-card:last-child {
      width: min(100%, 420px);
      grid-column: 1 / -1;
      justify-self: center;
    }

    .app-tour-copy {
      padding-right: 16px;
      padding-left: 16px;
    }
  }

  @media (max-width: 680px) {
    .nav-wrap {
      padding: 16px 20px;
    }

    .brand {
      font-size: 23px;
    }

    .brand-mark,
    .brand-mark svg {
      width: 34px;
      height: 34px;
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      padding: 10px 14px;
      font-size: 11px;
    }

    .hero {
      min-height: auto;
      padding: 52px 24px 70px;
      grid-template-columns: 1fr;
      gap: 44px;
    }

    h1 {
      max-width: 520px;
      font-size: clamp(47px, 12vw, 66px);
    }

    .hero-description {
      font-size: 15px;
    }

    .hero-note {
      margin-top: 27px;
    }

    .hero-art {
      width: min(100%, 440px);
      margin: 0 auto;
      padding: 0 8px 10px;
    }

    .hero-image-frame {
      aspect-ratio: 1.12;
      border-radius: 45% 45% 28px 28px;
    }

    .scroll-cue {
      display: none;
    }

    .section-pad {
      padding-right: 24px;
      padding-left: 24px;
    }

    .intro {
      padding-top: 70px;
      padding-bottom: 68px;
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .section-heading h2,
    .feature-copy h2,
    .community-copy h2 {
      font-size: clamp(38px, 10vw, 52px);
    }

    .intro-copy {
      max-width: 510px;
      font-size: 14px;
    }

    .feature {
      padding-top: 36px;
      padding-bottom: 55px;
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .feature-gallery {
      height: min(68vw, 340px);
      gap: 8px;
    }

    .feature-image,
    .feature-image-food {
      margin-top: 0;
      margin-bottom: 0;
      border-radius: 16px;
    }

    .feature-copy h2 {
      max-width: 500px;
    }

    .app-tour {
      padding-top: 76px;
      padding-bottom: 76px;
    }

    .app-tour-grid {
      max-width: 410px;
      margin: 34px auto 0;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .app-tour-card:last-child {
      width: auto;
      grid-column: auto;
    }

    .app-tour-copy {
      padding-right: 20px;
      padding-left: 20px;
    }

    .app-tour-note {
      align-items: flex-start;
      gap: 12px;
      margin-top: 24px;
      padding: 16px;
    }

    .app-tour-note-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
    }

    .app-tour-note p {
      font-size: 12px;
    }

    .steps {
      padding-top: 76px;
      padding-bottom: 80px;
    }

    .step-grid {
      margin-top: 36px;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .step-card {
      min-height: 0;
      padding: 20px;
    }

    .step-number {
      margin-bottom: 17px;
    }

    .community-content {
      padding: 65px 24px;
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .community-image {
      height: min(68vw, 330px);
      border-radius: 20px 20px 70px 20px;
    }

    .community-sticker {
      width: 85px;
      height: 85px;
      font-size: 13px;
    }

    .app-cta {
      padding-top: 80px;
      padding-bottom: 55px;
    }

    .app-cta-phone {
      margin-top: 34px;
      border-radius: 18px;
    }

    .footer {
      flex-wrap: wrap;
      padding: 20px 24px;
    }

    .footer p {
      order: 1;
      width: 100%;
    }
