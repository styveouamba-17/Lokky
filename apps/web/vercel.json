{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!\\.well-known/|activity/).*)",
      "has": [
        {
          "type": "host",
          "value": "lokky.akylian.com"
        }
      ],
      "destination": "https://lokky.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/activity/:id",
      "destination": "/activity"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
